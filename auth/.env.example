# Copy these into your deployment environment/secret manager; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/quartz
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
QUARTZ_PUBLIC_URL=http://localhost:8788
QUARTZ_WEB_URL=http://localhost:8080
PORT=8788

# Required to enable email one-time-code sign-in. Use credentials from your mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Quartz Sign-In <no-reply@example.com>

# Local development only; production should use verified TLS:
# DATABASE_SSL=disable